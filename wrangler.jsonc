{
  "name": "nfchane",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-15",
  "keep_vars": true,
  "vars": {"APP_ORIGIN":"https://nfchane.colves.workers.dev","CUSTOMER_AUTH_ENABLED":"false"},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  }
}
